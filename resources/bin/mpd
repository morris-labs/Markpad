#!/bin/sh
# mpd opens Markdown files in Markpad from a terminal.
#
# Markpad keeps one window: mpd adds each file as a tab in the running app,
# or starts the app, and then returns to the prompt.

# The "Install 'mpd' command" menu item fills in DEFAULT_APP. When it's empty,
# mpd looks for the app next to this script inside the installed package.
DEFAULT_APP=''
APP="${MARKPAD_APP:-$DEFAULT_APP}"
if [ -z "$APP" ]; then
  HERE=$(dirname "$(readlink -f "$0")")
  for candidate in "$HERE/../../markpad" "$HERE/../../MacOS/Markpad"; do
    if [ -x "$candidate" ]; then
      APP=$candidate
      break
    fi
  done
fi
if [ -z "$APP" ] || [ ! -x "$APP" ]; then
  echo "mpd: can't find the Markpad app. Set MARKPAD_APP to its executable." >&2
  exit 1
fi

usage() {
  cat <<'HELP'
Usage: mpd [OPTION]... [FILE]...
Open each FILE in Markpad, in a tab of the running window.

A FILE that doesn't exist opens as an empty document, and Markpad creates it
when you type. With no FILE, mpd starts Markpad or brings it to the front.

Options:
  -h, --help       Show this help and exit.
  -v, --version    Show the Markpad version and exit.
  --               Treat every later argument as a file name.
HELP
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  -v | --version)
    exec "$APP" --version
    ;;
  --)
    shift
    ;;
  -*)
    echo "mpd: unknown option: $1" >&2
    echo "Try 'mpd --help' for more information." >&2
    exit 2
    ;;
esac

# Detach, so closing the terminal doesn't close Markpad.
nohup "$APP" -- "$@" >/dev/null 2>&1 &
