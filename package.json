{
  "name": "markpad",
  "productName": "Markpad",
  "version": "0.1.0",
  "description": "A lightweight WYSIWYG Markdown editor",
  "main": "out/main/index.js",
  "license": "UNLICENSED",
  "private": true,
  "author": {
    "name": "Isaac Morris",
    "email": "isaac.s.morris@gmail.com"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "install-electron",
    "preview:web": "vite --config vite.preview.config.ts"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "^7.22.3",
    "@milkdown/plugin-prism": "^7.22.3",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "codemirror": "^6.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "homepage": "https://example.com/markpad",
  "desktopName": "markpad.desktop"
}
